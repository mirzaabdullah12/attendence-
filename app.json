{
  "expo": {
    "name": "8star Attendance",
    "slug": "8star-attendance",
    "version": "1.0.0",
    "scheme": "eightstar",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eightstar.attendance",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "8star Attendance uses your location to verify you are at an approved office when you clock in or out.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "8star Attendance tracks your location while you are on duty so your attendance trail is recorded accurately."
      }
    },
    "android": {
      "package": "com.eightstar.attendance",
      "adaptiveIcon": {
        "backgroundColor": "#0B0D10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B0D10"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "8star Attendance uses your location to verify you are at an approved office when you clock in or out.",
          "locationAlwaysAndWhenInUsePermission": "8star Attendance tracks your location while you are on duty so your attendance trail is recorded accurately.",
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "da56ed89-085f-47bb-a445-5be9f72828b3"
      }
    },
    "owner": "syedamirmobilezonetexas"
  }
}
